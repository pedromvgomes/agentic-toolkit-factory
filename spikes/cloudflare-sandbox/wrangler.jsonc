{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-sandbox-spike",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	// Credentials are Worker secrets only; the container receives placeholders.
	// `wrangler deploy` fails when one is missing. CODEX_AUTH_JSON_1 and _2 only
	// seed CodexCredentials, which stores the refreshed ChatGPT tokens from then on.
	"secrets": {
		"required": ["RUNNER_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN", "CODEX_AUTH_JSON_1", "CODEX_AUTH_JSON_2"],
	},
	"containers": [
		{
			"class_name": "AgentSandbox",
			"scheduling_policy": "durable_object",
			"images": {
				"agent": {
					"dockerfile": "./Dockerfile",
				},
			},
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "AgentSandbox",
				"name": "SANDBOX",
			},
			{
				"class_name": "CodexCredentials",
				"name": "CODEX_CREDENTIALS",
			},
		],
	},
	"exports": {
		"AgentSandbox": {
			"type": "durable-object",
			"storage": "sqlite",
		},
		"CodexCredentials": {
			"type": "durable-object",
			"storage": "sqlite",
		},
	},
}
